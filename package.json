{
  "name": "acervo-nft-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --experimental-strip-types --test tests/unit/eth.test.mjs tests/unit/opensea.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch@^10": "11.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
